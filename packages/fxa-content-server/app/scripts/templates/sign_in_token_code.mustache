<div id="main-content" class="card">
  <header>
    <h1 id="fxa-signin-code-header" class="card-header">{{#t}}Authorize this sign-in{{/t}}</h1>
  </header>

  <section>
    <div class="error"></div>
    <div class="success"></div>

    <div class="b-gimage-email"></div>

    <p id="verification-email-message" class="mb-5">
    {{#t}}Check your email for the code sent to %(email)s.{{/t}}
    </p>

    <form novalidate>
      <div class="input-row otp-code-row">
          <!-- Using `type="text" inputmode="numeric"` shows the numericpad on mobile and strips out whitespace on desktop. -->
          <input type="text" inputmode="numeric" pattern="\d[ ]*" class="tooltip-below otp-code" placeholder="{{#t}}Enter 6-digit code{{/t}}" required autofocus />
      </div>

      <div class="flex">
        <button type="submit" id="use-logged-in" class="cta-primary cta-xl">{{#t}}Continue{{/t}}</button>
      </div>

    </form>

    <div class="flex justify-between animate-delayed-fade-in opacity-0 mt-5">
        <a id="resend" class="link-blue" href="#">{{#t}}Need another code? Resend{{/t}}</a>
        <a href="{{{ escapedSupportLink }}}" id="support-link" class="link-blue" target="_blank">{{#t}}Why is this happening?{{/t}}</a>
    </div>
  </section>
</div>
